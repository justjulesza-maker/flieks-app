{
  "rules": {
    "flieks_films": {
      ".read": true,
      ".indexOn": ["filmmaker_uid", "status"],
      "$filmId": {
        ".validate": "$filmId.matches(/^[A-Za-z0-9_-]{1,120}$/)",
        ".write": "auth != null && (root.child('flieks_users').child(auth.uid).child('role').val() === 'admin' || (root.child('flieks_users').child(auth.uid).child('role').val() === 'filmmaker' && (data.exists() ? data.child('filmmaker_uid').val() === auth.uid : newData.child('filmmaker_uid').val() === auth.uid) && (!newData.exists() || newData.child('filmmaker_uid').val() === auth.uid)))",
        "status":     { ".validate": "newData.val() === data.val() || newData.val() === 'review' || root.child('flieks_users').child(auth.uid).child('role').val() === 'admin'" },
        "featured":   { ".validate": "newData.val() === data.val() || newData.val() === false || root.child('flieks_users').child(auth.uid).child('role').val() === 'admin'" },
        "view_count": {
          ".write": "auth != null",
          ".validate": "newData.isNumber() && (newData.val() === data.val() || newData.val() === (data.exists() ? data.val() : 0) + 1 || (!data.exists() && newData.val() === 0) || root.child('flieks_users').child(auth.uid).child('role').val() === 'admin')"
        },
        "rent_count": { ".validate": "newData.val() === data.val() || (!data.exists() && newData.val() === 0) || root.child('flieks_users').child(auth.uid).child('role').val() === 'admin'" },
        "own_count":  { ".validate": "newData.val() === data.val() || (!data.exists() && newData.val() === 0) || root.child('flieks_users').child(auth.uid).child('role').val() === 'admin'" },
        "title":         { ".validate": "newData.isString() && newData.val().length <= 160" },
        "filmmaker":     { ".validate": "newData.isString() && newData.val().length <= 120" },
        "synopsis":      { ".validate": "newData.isString() && newData.val().length <= 3000" },
        "about":         { ".validate": "newData.isString() && newData.val().length <= 4000" },
        "language":      { ".validate": "newData.isString() && newData.val().length <= 80" },
        "subtitles":     { ".validate": "newData.isString() && newData.val().length <= 80" },
        "duration_mins": { ".validate": "root.child('flieks_users').child(auth.uid).child('role').val() === 'admin' || (newData.isNumber() && newData.val() > 0 && newData.val() <= 600)" },
        "poster_bg":     { ".validate": "root.child('flieks_users').child(auth.uid).child('role').val() === 'admin' || (newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{3,8}$/))" },
        "poster_url":    { ".validate": "root.child('flieks_users').child(auth.uid).child('role').val() === 'admin' || (newData.isString() && (newData.val() === '' || (newData.val().beginsWith('https://firebasestorage.googleapis.com/') && !newData.val().contains('\"') && !newData.val().contains(\"'\") && !newData.val().contains('<') && !newData.val().contains('>') && !newData.val().contains(' '))))" },
        "trailer_url":   { ".validate": "root.child('flieks_users').child(auth.uid).child('role').val() === 'admin' || (newData.isString() && (newData.val() === '' || (newData.val().beginsWith('https://firebasestorage.googleapis.com/') && !newData.val().contains('\"') && !newData.val().contains(\"'\") && !newData.val().contains('<') && !newData.val().contains('>') && !newData.val().contains(' '))))" },
        "og_image":      { ".validate": "root.child('flieks_users').child(auth.uid).child('role').val() === 'admin' || (newData.isString() && (newData.val() === '' || (newData.val().beginsWith('https://firebasestorage.googleapis.com/') && !newData.val().contains('\"') && !newData.val().contains(\"'\") && !newData.val().contains('<') && !newData.val().contains('>') && !newData.val().contains(' '))))" },
        "price_request": { ".validate": "root.child('flieks_users').child(auth.uid).child('role').val() === 'admin' || (newData.child('rent').isNumber() && newData.child('own').isNumber())" },
        "price_rent": { ".validate": "newData.isNumber() && (newData.val() === data.val() || root.child('flieks_users').child(auth.uid).child('role').val() === 'admin' || !root.child('flieks_settings').child('price_cap').child('rent').exists() || newData.val() <= root.child('flieks_settings').child('price_cap').child('rent').val())" },
        "price_own": { ".validate": "newData.isNumber() && (newData.val() === data.val() || root.child('flieks_users').child(auth.uid).child('role').val() === 'admin' || !root.child('flieks_settings').child('price_cap').child('own').exists() || newData.val() <= root.child('flieks_settings').child('price_cap').child('own').val())" }
      }
    },
    "flieks_settings": {
      ".read": true,
      ".write": "auth != null && root.child('flieks_users').child(auth.uid).child('role').val() === 'admin'"
    },
    "flieks_users": {
      ".read": "auth != null && root.child('flieks_users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid || root.child('flieks_users').child(auth.uid).child('role').val() === 'admin'",
        "role": { ".validate": "newData.val() === data.val() || (!data.exists() && (newData.val() === 'viewer' || newData.val() === 'filmmaker_pending')) || root.child('flieks_users').child(auth.uid).child('role').val() === 'admin'" }
      }
    },
    "flieks_purchases": {
      ".read": "auth != null && root.child('flieks_users').child(auth.uid).child('role').val() === 'admin'",
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": false
      }
    },
    "flieks_transactions": {
      ".read": "auth != null && root.child('flieks_users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": ["filmmaker_uid", "uid"],
      "$txId": { ".write": false }
    },
    "flieks_admin_queue": {
      ".read": "auth != null && root.child('flieks_users').child(auth.uid).child('role').val() === 'admin'",
      ".indexOn": ["status"],
      "$qid": { ".write": "auth != null && (root.child('flieks_users').child(auth.uid).child('role').val() === 'admin' || (!data.exists() && newData.child('filmmaker_uid').val() === auth.uid))" }
    },
    "flieks_filmmaker_applications": {
      ".read": "auth != null && root.child('flieks_users').child(auth.uid).child('role').val() === 'admin'",
      "$appId": {
        ".write": "auth != null && (root.child('flieks_users').child(auth.uid).child('role').val() === 'admin' || ((data.exists() ? data.child('uid').val() === auth.uid : newData.child('uid').val() === auth.uid) && (!newData.exists() || newData.child('uid').val() === auth.uid)))",
        "status": { ".validate": "newData.val() === data.val() || newData.val() === 'pending' || root.child('flieks_users').child(auth.uid).child('role').val() === 'admin'" }
      }
    },
    "flieks_payouts": {
      ".read": false,
      ".write": false,
      "$uid": {
        ".read": "$uid === auth.uid"
      }
    },

    "flieks_agreements": {
      ".read": false,
      ".write": false,
      "$uid": { ".read": "$uid === auth.uid" }
    },

    "flieks_bank": {
      ".read": false,
      ".write": false
    },

    "flieks_film_slugs": {
      ".read": true,
      "$slug": {
        ".write": "auth != null && (root.child('flieks_users').child(auth.uid).child('role').val() === 'admin' || (root.child('flieks_users').child(auth.uid).child('role').val() === 'filmmaker' && (!data.exists() || root.child('flieks_films').child(data.val()).child('filmmaker_uid').val() === auth.uid) && (!newData.exists() || root.child('flieks_films').child(newData.val()).child('filmmaker_uid').val() === auth.uid)))",
        ".validate": "newData.isString()"
      }
    },

    "flieks_cast": {
      ".read": true,
      "$filmId": {
        ".write": "auth != null && (root.child('flieks_users').child(auth.uid).child('role').val() === 'admin' || root.child('flieks_films').child($filmId).child('filmmaker_uid').val() === auth.uid)",
        "$slug": {
          ".validate": "$slug.matches(/^[A-Za-z0-9_-]{1,80}$/)",
          "name":      { ".validate": "newData.isString() && newData.val().length <= 100" },
          "role":      { ".validate": "newData.isString() && newData.val().length <= 100" },
          "photoUrl":  { ".validate": "newData.isString() && (newData.val() === '' || (newData.val().beginsWith('https://firebasestorage.googleapis.com/') && !newData.val().contains('\"') && !newData.val().contains(\"'\") && !newData.val().contains('<') && !newData.val().contains('>') && !newData.val().contains(' ')))" },
          "instagram": { ".validate": "newData.isString() && (newData.val() === '' || (newData.val().beginsWith('https://') && !newData.val().contains('\"') && !newData.val().contains(\"'\") && !newData.val().contains('<') && !newData.val().contains('>') && !newData.val().contains(' ')) || newData.val().matches(/^@?[A-Za-z0-9_.]{1,60}$/))" },
          "tiktok":    { ".validate": "newData.isString() && (newData.val() === '' || (newData.val().beginsWith('https://') && !newData.val().contains('\"') && !newData.val().contains(\"'\") && !newData.val().contains('<') && !newData.val().contains('>') && !newData.val().contains(' ')) || newData.val().matches(/^@?[A-Za-z0-9_.]{1,60}$/))" },
          "x":         { ".validate": "newData.isString() && (newData.val() === '' || (newData.val().beginsWith('https://') && !newData.val().contains('\"') && !newData.val().contains(\"'\") && !newData.val().contains('<') && !newData.val().contains('>') && !newData.val().contains(' ')) || newData.val().matches(/^@?[A-Za-z0-9_.]{1,60}$/))" },
          "youtube":   { ".validate": "newData.isString() && (newData.val() === '' || (newData.val().beginsWith('https://') && !newData.val().contains('\"') && !newData.val().contains(\"'\") && !newData.val().contains('<') && !newData.val().contains('>') && !newData.val().contains(' ')) || newData.val().matches(/^@?[A-Za-z0-9_.]{1,60}$/))" },
          "facebook":  { ".validate": "newData.isString() && (newData.val() === '' || (newData.val().beginsWith('https://') && !newData.val().contains('\"') && !newData.val().contains(\"'\") && !newData.val().contains('<') && !newData.val().contains('>') && !newData.val().contains(' ')) || newData.val().matches(/^@?[A-Za-z0-9_.]{1,60}$/))" },
          "reach":     { ".validate": "newData.isString() && newData.val().length <= 40" }
        }
      }
    },

    "flieks_result_keys": {
      ".read": false,
      "$key": {
        ".write": "auth != null && (root.child('flieks_users').child(auth.uid).child('role').val() === 'admin' || root.child('flieks_films').child(newData.val()).child('filmmaker_uid').val() === auth.uid || (!newData.exists() && data.exists() && root.child('flieks_films').child(data.val()).child('filmmaker_uid').val() === auth.uid))",
        ".validate": "!newData.exists() || newData.isString()"
      }
    },

    "flieks_reviews": {
      ".read": true,
      ".write": false,
      "$filmId": { ".indexOn": ["created_at", "rating"] }
    },

    "flieks_support": {
      ".read": "auth != null && root.child('flieks_users').child(auth.uid).child('role').val() === 'admin'",
      ".write": false
    },

    "flieks_ops": {
      ".read": "auth != null && root.child('flieks_users').child(auth.uid).child('role').val() === 'admin'",
      ".write": false
    },

    "flieks_moderation": {
      ".read": "auth != null && root.child('flieks_users').child(auth.uid).child('role').val() === 'admin'",
      ".write": false
    },

    "flieks_private": {
      ".read": false,
      "$filmId": {
        ".write": "auth != null && !$filmId.beginsWith('pod_') && (root.child('flieks_users').child(auth.uid).child('role').val() === 'admin' || root.child('flieks_films').child($filmId).child('filmmaker_uid').val() === auth.uid)",
        "video_url":  { ".validate": "root.child('flieks_users').child(auth.uid).child('role').val() === 'admin' || (newData.isString() && newData.val().beginsWith('https://firebasestorage.googleapis.com/v0/b/flieks-app.firebasestorage.app/o/flieks_films%2F' + $filmId + '%2F') && !newData.val().contains('\"') && !newData.val().contains(\"'\") && !newData.val().contains('<') && !newData.val().contains('>') && !newData.val().contains(' '))" },
        "script_url": { ".validate": "root.child('flieks_users').child(auth.uid).child('role').val() === 'admin' || (newData.isString() && newData.val().beginsWith('https://firebasestorage.googleapis.com/v0/b/flieks-app.firebasestorage.app/o/flieks_scripts%2F' + $filmId + '%2F') && !newData.val().contains('\"') && !newData.val().contains(\"'\") && !newData.val().contains('<') && !newData.val().contains('>') && !newData.val().contains(' '))" },
        "$other":     { ".validate": "root.child('flieks_users').child(auth.uid).child('role').val() === 'admin'" }
      }
    },

    "flieks_gifts":    { ".read": false, ".write": false },
    "flieks_orders":   { ".read": false, ".write": false },

    "flieks_my_gifts": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": false
      }
    },

    "flieks_stats": {
      ".read": "auth != null && root.child('flieks_users').child(auth.uid).child('role').val() === 'admin'",
      ".write": false,
      "$filmId": {
        "views":        { ".read": true, ".write": true, ".validate": "newData.isNumber() && (!data.exists() ? newData.val() === 1 : newData.val() === data.val() + 1)" },
        "clicks":       { ".read": true, ".write": true, ".validate": "newData.isNumber() && (!data.exists() ? newData.val() === 1 : newData.val() === data.val() + 1)" },
        "trailerPlays": { ".read": true, ".write": true, ".validate": "newData.isNumber() && (!data.exists() ? newData.val() === 1 : newData.val() === data.val() + 1)" },
        "refs": {
          "$slug": {
            "clicks":       { ".read": true, ".write": true, ".validate": "newData.isNumber() && (!data.exists() ? newData.val() === 1 : newData.val() === data.val() + 1)" },
            "trailerPlays": { ".read": true, ".write": true, ".validate": "newData.isNumber() && (!data.exists() ? newData.val() === 1 : newData.val() === data.val() + 1)" }
          }
        }
      }
    },

    "dd_config": {
      ".read": true,
      ".write": "auth != null && root.child('flieks_users').child(auth.uid).child('role').val() === 'admin'"
    },

    "dd_cast": {
      ".read": true,
      ".write": "auth != null && root.child('flieks_users').child(auth.uid).child('role').val() === 'admin'"
    },

    "dd_private": {
      ".read": "auth != null && root.child('flieks_users').child(auth.uid).child('role').val() === 'admin'",
      ".write": "auth != null && root.child('flieks_users').child(auth.uid).child('role').val() === 'admin'"
    },
    "dd_orders":  { ".read": false, ".write": false },
    "dd_gifts":   { ".read": false, ".write": false },

    "dd_my_gifts": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": false
      }
    },

    "dd_reviews": {
      ".read": true,
      ".indexOn": ["approved", "createdAt"],
      "$rid": {
        ".write": "auth != null && (!data.exists() || root.child('flieks_users').child(auth.uid).child('role').val() === 'admin')",
        ".validate": "newData.hasChildren(['uid','rating','body','approved','createdAt'])",
        "uid":       { ".validate": "newData.val() === auth.uid" },
        "rating":    { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5" },
        "body":      { ".validate": "newData.isString() && newData.val().length >= 10 && newData.val().length <= 600" },
        "approved":  { ".validate": "newData.isBoolean() && (newData.val() === false || root.child('flieks_users').child(auth.uid).child('role').val() === 'admin')" },
        "name":      { ".validate": "newData.isString() && newData.val().length <= 60" },
        "ref":       { ".validate": "newData.isString() || newData.val() === null" },
        "createdAt": { ".validate": "newData.val() === now" },
        "$other":    { ".validate": false }
      }
    },

    "dd_stats": {
      ".read": "auth != null && root.child('flieks_users').child(auth.uid).child('role').val() === 'admin'",
      ".write": false,
      "trailerPlays": { ".read": true, ".write": true, ".validate": "newData.isNumber() && (!data.exists() ? newData.val() === 1 : newData.val() === data.val() + 1)" },
      "plays":        { ".read": true, ".write": true, ".validate": "newData.isNumber() && (!data.exists() ? newData.val() === 1 : newData.val() === data.val() + 1)" },
      "refs": {
        "$slug": {
          "clicks":       { ".read": true, ".write": true, ".validate": "newData.isNumber() && (!data.exists() ? newData.val() === 1 : newData.val() === data.val() + 1)" },
          "trailerPlays": { ".read": true, ".write": true, ".validate": "newData.isNumber() && (!data.exists() ? newData.val() === 1 : newData.val() === data.val() + 1)" }
        }
      }
    },

    "script_coach": {
      ".read": true,
      ".write": false
    }
  }
}
